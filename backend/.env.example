# Copy to backend/.env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (MONGO_URI is an accepted alias of MONGODB_URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopmart?retryWrites=true&w=majority
MONGO_URI=

# JWT — production refuses to start unless both are 32+ characters and not placeholders
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_EXPIRES=
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Demo admin, created only when NODE_ENV is not production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=ShopMart Admin

# Gmail SMTP (use an app password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="ShopMart <your@gmail.com>"
CONTACT_INBOX=your@gmail.com

# Google OAuth — https://console.cloud.google.com
# GOOGLE_CLIENT_ID is public. Also copy it to frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLOCK_TOLERANCE_SEC=86400

# Gemini — server only. Never put this in a frontend env file.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_API_KEY=
