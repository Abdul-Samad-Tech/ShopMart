# Vercel Environment Variables
# Copy these to your Vercel project settings

# Frontend
VITE_API_URL=/api

# Backend - MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shophub?retryWrites=true&w=majority

# Backend - Server
PORT=5000
CLIENT_URL=https://your-vercel-app.vercel.app

# Backend - JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Backend - Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=ShopMart Admin

# Backend - Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="ShopMart <your@gmail.com>"

# Backend - Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLOCK_TOLERANCE_SEC=86400

# Backend - Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
